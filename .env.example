# Copia este archivo a .env y llena los valores. NUNCA subas .env a git.

# Gemini API: crea la clave en https://aistudio.google.com -> "Get API key".
# Para generar imágenes por API hay que activar la facturación en Google Cloud.
GEMINI_API_KEY=

# ID del modelo de imagen vigente (OPEN: confírmalo en AI Studio; el reporte apunta a "Nano Banana 2.1").
GEMINI_IMAGE_MODEL=

# Opcional, solo para el respaldo: https://platform.openai.com/api-keys
OPENAI_API_KEY=
