# Copia este archivo a .env y llena los valores. NUNCA subas .env a git.

# Gemini API: crea la clave en https://aistudio.google.com -> "Get API key".
# Para generar imágenes por API hay que activar la facturación en Google Cloud.
# En la sesión en la nube NO va aquí: está guardada como Network secret del entorno
# (host generativelanguage.googleapis.com, header x-goog-api-key) y el proxy la agrega sola.
# Los scripts mandan un valor de relleno si GEMINI_API_KEY está vacío.
GEMINI_API_KEY=

# Modelo de imagen (verificado el 2026-11-16 con la lista de modelos de la API).
# Respaldo dentro de Google: gemini-3-pro-image (Nano Banana Pro).
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1

# Opcional, solo para el respaldo: https://platform.openai.com/api-keys
OPENAI_API_KEY=
